{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.14.0",
      "env": {
        "EXPO_PUBLIC_ZERODEV_PROJECT_ID": "c107f734-f7bb-48c1-a5d2-ceb3f70a42f6",
        "EXPO_PUBLIC_SWARMY_KEY": "36888b0c2abab37f14314"
      }
    },
    "development": {
      "extends": "base",
      "autoIncrement": false,
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug -PreactNativeArchitectures=arm64-v8a"
      }
    },
    "preview": {
      "extends": "base",
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "prod"
      },
      "android": {
        "gradleCommand": ":app:bundleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a,x86_64"
      }
    },
    "development-prod": {
      "extends": "development",
      "env": {
        "APP_VARIANT": "prod"
      }
    },
    "preview-prod": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "prod"
      }
    },
    "production-prod": {
      "extends": "production"
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed",
        "applicationId": "box.stage",
        "serviceAccountKeyPath": "./play-service-account.json"
      },
      "ios": {
        "ascApiKeyPath": "./asc-api-key.p8"
      }
    },
    "closed": {
      "android": {
        "track": "alpha",
        "releaseStatus": "completed",
        "applicationId": "box.stage",
        "serviceAccountKeyPath": "./play-service-account.json"
      },
      "ios": {
        "ascApiKeyPath": "./asc-api-key.p8"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed",
        "applicationId": "box.stage",
        "serviceAccountKeyPath": "./play-service-account.json"
      },
      "ios": {
        "ascApiKeyPath": "./asc-api-key.p8"
      }
    }
  }
}
