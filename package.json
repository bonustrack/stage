{
  "name": "stage-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Stage — an XMTP messenger with multi-account support, Snapshot profiles, group channels, and an onchain wallet, shipped as one universal Expo app for android, ios and web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonustrack/stage.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/stage/desktop"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "stage typecheck",
    "lint": "stage lint",
    "lint:fix": "stage lint --fix",
    "madge": "stage madge",
    "knip": "stage knip",
    "check": "bun run lint && turbo run typecheck",
    "report:deps": "bun run madge || true; bun run knip || true",
    "served:reset": "bash scripts/served-reset.sh",
    "served:drift-check": "bash scripts/served-drift-check.sh",
    "worktree:prune": "bash scripts/worktree-prune.sh"
  },
  "devDependencies": {
    "@stage-labs/config": "workspace:*",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "^6.15.0",
    "madge": "^8.0.0",
    "turbo": "^2.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.59.2"
  },
  "trustedDependencies": ["electron"],
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "patchedDependencies": {
    "@xmtp/wasm-bindings@1.10.0": "patches/@xmtp%2Fwasm-bindings@1.10.0.patch",
    "expo@57.0.25": "patches/expo@57.0.25.patch",
    "@expo/metro-config@57.0.12": "patches/@expo%2Fmetro-config@57.0.12.patch",
    "expo-router@57.0.23": "patches/expo-router@57.0.23.patch",
    "@xmtp/react-native-sdk@5.7.0": "patches/@xmtp%2Freact-native-sdk@5.7.0.patch",
    "@react-native-masked-view/masked-view@0.3.2": "patches/@react-native-masked-view%2Fmasked-view@0.3.2.patch"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  }
}
