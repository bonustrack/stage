{
  "name": "stage-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Stage — an XMTP messenger with multi-account support, Snapshot profiles, group channels, and an onchain wallet, shipped as one universal Expo app for android, ios and web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonustrack/stage.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/stage/desktop"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:changed": "TURBO_SCM_BASE=origin/main turbo run test --affected",
    "typecheck": "stage typecheck",
    "typecheck:tsc": "stage typecheck --tsc",
    "lint": "stage lint",
    "lint:fix": "stage lint --fix",
    "lint:changed": "stage lint --changed",
    "madge": "stage madge",
    "knip": "stage knip",
    "check": "bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@stage-labs/config": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.3.0",
    "knip": "^6.15.0",
    "madge": "^8.0.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "^2.3.3",
    "typescript": "~5.9.2"
  },
  "trustedDependencies": ["electron"],
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "patchedDependencies": {
    "@xmtp/wasm-bindings@1.10.0": "patches/@xmtp%2Fwasm-bindings@1.10.0.patch",
    "expo@57.0.25": "patches/expo@57.0.25.patch",
    "@expo/metro-config@57.0.12": "patches/@expo%2Fmetro-config@57.0.12.patch",
    "expo-router@57.0.23": "patches/expo-router@57.0.23.patch",
    "@xmtp/react-native-sdk@5.7.0": "patches/@xmtp%2Freact-native-sdk@5.7.0.patch",
    "@react-native-masked-view/masked-view@0.3.2": "patches/@react-native-masked-view%2Fmasked-view@0.3.2.patch",
    "react-native-webrtc@124.0.8": "patches/react-native-webrtc@124.0.8.patch",
    "expo-dev-launcher@57.0.20": "patches/expo-dev-launcher@57.0.20.patch"
  }
}
