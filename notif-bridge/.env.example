# --- Bridge XMTP identity (SECRET — Less provisions) ---
# Raw EOA private key (0x-prefixed, 32 bytes) the bridge uses as its own XMTP inbox.
# The PUBLIC address of this key is what the Stage client points at
# (EXPO_PUBLIC_NOTIF_BRIDGE_INBOX in the app build).
BRIDGE_XMTP_PRIVATE_KEY=0x...

# XMTP network: production | dev | local  (must match the client's XMTP env)
BRIDGE_XMTP_ENV=production

# Path to the bridge's persistent MLS SQLite store. MUST live on a persistent
# volume — losing it loses the inbox's group state.
BRIDGE_XMTP_DB_PATH=./data/xmtp.db3

# Optional 32-byte hex key to encrypt the local MLS store at rest.
# BRIDGE_XMTP_DB_KEY=

# --- FCM credentials (SECRET — Less provisions) ---
# Provide EITHER an inline service-account JSON or a path to it.
# FCM_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"...","project_id":"..."}
FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# --- Storage / tuning ---
BRIDGE_TOKENS_PATH=./data/push-tokens.json
BRIDGE_SYNC_MS=15000
BRIDGE_ACCOUNT_ID=bridge
