                ],
                "message": "Use useActiveAccount() / AccountManager from '@/modules/messaging', not lib/accountEpoch."
              },
              {
                "group": [
                  "**/lib/channelsCache"
                ],
                "message": "Import the channels cache via the '@/modules/messaging' facade barrel, not lib/channelsCache."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "apps/stage/components/layout/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
