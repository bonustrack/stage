      ],
      "rules": {
        "core/no-restricted-syntax": [
          "error",
          {
            "selector": "MemberExpression[object.name='Math'][property.name='random']",
            "message": "The crypto shim must never fall back to Math.random; require a CSPRNG or throw."
          }
        ]
      }
    },
    {
      "files": [
        "apps/stage/**/*.js"
